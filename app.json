{
  "id": "com.local.sigenergy.optimizer",
  "version": "0.17.0",
  "sdk": 3,
  "author": {
    "name": "Marza"
  },
  "compatibility": ">=12.4.5",
  "name": {
    "en": "Sigenergy Local Monitor",
    "sv": "Sigenergy lokal övervakning"
  },
  "description": {
    "en": "Local read-only Sigenergy and optional Nibe SMO S40 monitoring, outage advisory, Tibber and EV planning",
    "sv": "Lokal övervakning och inlärningsläge med optimeringssimulering utan skrivstyrning"
  },
  "category": "energy",
  "permissions": [],
  "api": {
    "previewEconomics": {
      "method": "POST",
      "path": "/economics/preview",
      "public": false
    },
    "exportHistory": {
      "method": "GET",
      "path": "/history/export",
      "public": false
    },
    "previewHistoryImport": {
      "method": "POST",
      "path": "/history/import/preview",
      "public": false
    },
    "importHistory": {
      "method": "POST",
      "path": "/history/import",
      "public": false
    },
    "previewCharging": {
      "method": "POST",
      "path": "/charging/preview",
      "public": false
    },
    "getEnergyCounters": {
      "method": "GET",
      "path": "/energy/counters",
      "public": false
    }
  },
  "platforms": ["local"],
  "capabilities": {
    "measure_grid_power": {
      "type": "number",
      "title": {
        "en": "Grid power",
        "sv": "Näteffekt"
      },
      "units": {
        "en": "W"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    },
    "measure_ess_power": {
      "type": "number",
      "title": {
        "en": "Battery power",
        "sv": "Batterieffekt"
      },
      "units": {
        "en": "W"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    },
    "measure_pv_power": {
      "type": "number",
      "title": {
        "en": "Solar power",
        "sv": "Soleffekt"
      },
      "units": {
        "en": "W"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    },
    "measure_ess_capacity": {
      "type": "number",
      "title": {
        "en": "Battery capacity",
        "sv": "Batterikapacitet"
      },
      "units": {
        "en": "kWh"
      },
      "getable": true,
      "setable": false,
      "decimals": 1
    },
    "measure_ev_soc": {
      "type": "number",
      "title": {
        "en": "EV state of charge",
        "sv": "Bilens laddniva"
      },
      "units": {
        "en": "%"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    },
    "measure_ev_power": {
      "type": "number",
      "title": {
        "en": "EV charging power",
        "sv": "Bilens laddeffekt"
      },
      "units": {
        "en": "W"
      },
      "getable": true,
      "setable": false,
      "decimals": 0
    },
    "measure_energy_status": {
      "type": "enum",
      "title": {
        "en": "Energy counters",
        "sv": "Energiräknare"
      },
      "getable": true,
      "setable": false,
      "values": [
        {
          "id": "disabled",
          "title": {
            "en": "Disabled",
            "sv": "Avstängda"
          }
        },
        {
          "id": "waiting",
          "title": {
            "en": "Waiting for source",
            "sv": "Inväntar källa"
          }
        },
        {
          "id": "ok",
          "title": {
            "en": "Current",
            "sv": "Aktuella"
          }
        },
        {
          "id": "partial",
          "title": {
            "en": "Partly available",
            "sv": "Delvis tillgängliga"
          }
        },
        {
          "id": "stale",
          "title": {
            "en": "Stale",
            "sv": "För gamla"
          }
        },
        {
          "id": "reset-required",
          "title": {
            "en": "Counter reset — verify and acknowledge",
            "sv": "Räknare har minskat — verifiera och bekräfta"
          }
        },
        {
          "id": "source-changed",
          "title": {
            "en": "Source changed — verify and acknowledge",
            "sv": "Ändrad källa — verifiera och bekräfta"
          }
        },
        {
          "id": "invalid",
          "title": {
            "en": "Unavailable or invalid",
            "sv": "Otillgängliga eller ogiltiga"
          }
        }
      ]
    }
  },
  "drivers": [
    {
      "id": "sigenergy",
      "name": {
        "en": "Sigenergy plant",
        "sv": "Sigenergy-anläggning"
      },
      "class": "battery",
      "capabilities": [
        "measure_battery",
        "measure_grid_power",
        "measure_ess_power",
        "measure_pv_power",
        "measure_ess_capacity",
        "measure_ev_soc",
        "measure_ev_power"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": {
            "en": "Modbus host/IP"
          },
          "value": "192.168.1.100"
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Modbus port"
          },
          "value": 502
        },
        {
          "id": "unitId",
          "type": "number",
          "label": {
            "en": "Plant unit ID"
          },
          "value": 247
        },
        {
          "id": "addressOffset",
          "type": "number",
          "label": {
            "en": "Address offset (0 or -1)"
          },
          "value": 0
        },
        {
          "id": "pollSeconds",
          "type": "number",
          "label": {
            "en": "Poll interval seconds"
          },
          "value": 10
        },
        {
          "id": "evdcEnabled",
          "type": "checkbox",
          "label": {
            "en": "Experimental EVDC read (verify firmware/register map first)"
          },
          "value": false
        },
        {
          "id": "evdcPowerAddress",
          "type": "number",
          "label": {
            "en": "EVDC power register"
          },
          "value": 31502
        },
        {
          "id": "evdcSocAddress",
          "type": "number",
          "label": {
            "en": "EVDC SoC register"
          },
          "value": 31504
        },
        {
          "id": "evdcPowerScale",
          "type": "number",
          "label": {
            "en": "EVDC power divisor"
          },
          "value": 1
        },
        {
          "id": "evdcSocScale",
          "type": "number",
          "label": {
            "en": "EVDC SoC divisor"
          },
          "value": 1
        },
        {
          "id": "energyMetersProfile",
          "type": "dropdown",
          "label": {
            "en": "Cumulative energy register profile",
            "sv": "Registerprofil för kumulativ energi"
          },
          "value": "disabled",
          "values": [
            {
              "id": "disabled",
              "label": {
                "en": "Disabled (power only)",
                "sv": "Avstängd (endast effekt)"
              }
            },
            {
              "id": "sigenergy-v29-statistics",
              "label": {
                "en": "Sigenergy V2.9 new statistics (confirm firmware support)",
                "sv": "Sigenergy V2.9 ny statistik (bekräfta firmwarestöd)"
              }
            }
          ]
        },
        {
          "id": "energyCounterEpoch",
          "type": "number",
          "label": {
            "en": "Counter reference generation (increase only after verifying reset/source change)",
            "sv": "Räknarreferensens generation (öka först efter verifierad återställning/källändring)"
          },
          "value": 0,
          "min": 0,
          "step": 1
        },
        {
          "id": "energySolarSource",
          "type": "dropdown",
          "label": {
            "en": "Solar kWh source",
            "sv": "Källa för solenergi (kWh)"
          },
          "value": "self",
          "values": [
            {
              "id": "self",
              "label": {
                "en": "Sigenergy own PV only",
                "sv": "Endast Sigenergys egen PV"
              }
            },
            {
              "id": "third-party",
              "label": {
                "en": "Third-party inverter only",
                "sv": "Endast tredjepartsinverter"
              }
            },
            {
              "id": "combined",
              "label": {
                "en": "Own PV + third-party inverter",
                "sv": "Egen PV + tredjepartsinverter"
              }
            }
          ]
        },
        {
          "id": "energySolarReference",
          "type": "number",
          "label": {
            "en": "Confirmed solar-source changes (increase by 1 after verification)",
            "sv": "Bekräftade byten av solkälla (öka med 1 efter kontroll)"
          },
          "value": 0,
          "min": 0,
          "step": 1
        }
      ]
    },
    {
      "id": "energy-grid",
      "name": {
        "en": "Sigenergy Energy — grid",
        "sv": "Sigenergy Energy — nät"
      },
      "class": "sensor",
      "capabilities": [
        "measure_power",
        "meter_power.imported",
        "meter_power.exported",
        "measure_energy_status"
      ],
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power.imported",
        "cumulativeExportedCapability": "meter_power.exported"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "enabled",
          "type": "checkbox",
          "label": {
            "en": "Publish live readings (avoid duplicate Energy sources)",
            "sv": "Publicera aktuella värden (undvik dubbla energikällor)"
          },
          "value": true
        }
      ],
      "capabilitiesOptions": {
        "meter_power.imported": {
          "decimals": 2,
          "title": {
            "en": "Imported energy",
            "sv": "Importerad energi"
          },
          "min": 0
        },
        "meter_power.exported": {
          "decimals": 2,
          "title": {
            "en": "Exported energy",
            "sv": "Exporterad energi"
          },
          "min": 0
        }
      }
    },
    {
      "id": "energy-solar",
      "name": {
        "en": "Sigenergy Energy — solar",
        "sv": "Sigenergy Energy — sol"
      },
      "class": "solarpanel",
      "capabilities": ["measure_power", "meter_power", "measure_energy_status"],
      "energy": {
        "meterPowerExportedCapability": "meter_power"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "enabled",
          "type": "checkbox",
          "label": {
            "en": "Publish live readings (avoid duplicate Energy sources)",
            "sv": "Publicera aktuella värden (undvik dubbla energikällor)"
          },
          "value": true
        }
      ],
      "capabilitiesOptions": {
        "meter_power": {
          "decimals": 2,
          "title": {
            "en": "Solar generation",
            "sv": "Solproduktion"
          },
          "min": 0
        }
      }
    },
    {
      "id": "energy-battery",
      "name": {
        "en": "Sigenergy Energy — battery",
        "sv": "Sigenergy Energy — batteri"
      },
      "class": "battery",
      "capabilities": [
        "measure_power",
        "measure_battery",
        "meter_power.charged",
        "meter_power.discharged",
        "measure_energy_status"
      ],
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "enabled",
          "type": "checkbox",
          "label": {
            "en": "Publish live readings (avoid duplicate Energy sources)",
            "sv": "Publicera aktuella värden (undvik dubbla energikällor)"
          },
          "value": true
        }
      ],
      "capabilitiesOptions": {
        "meter_power.charged": {
          "decimals": 2,
          "title": {
            "en": "Charged energy",
            "sv": "Laddad energi"
          },
          "min": 0
        },
        "meter_power.discharged": {
          "decimals": 2,
          "title": {
            "en": "Discharged energy",
            "sv": "Urladdad energi"
          },
          "min": 0
        }
      }
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "backup_mode_changed",
        "title": {
          "en": "Backup mode changed",
          "sv": "Reservkraftsläge ändrades"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Grid mode",
              "sv": "Nätläge"
            }
          },
          {
            "name": "ev_stop_requested",
            "type": "boolean",
            "title": {
              "en": "EV stop requested",
              "sv": "Begärt laddstopp"
            }
          },
          {
            "name": "nibe_mode",
            "type": "string",
            "title": {
              "en": "Nibe mode requested",
              "sv": "Begärt Nibe-läge"
            }
          }
        ]
      }
    ]
  },
  "widgets": {
    "energy-overview": {
      "id": "energy-overview",
      "name": {
        "en": "Energy overview",
        "sv": "Energiöversikt"
      },
      "description": {
        "en": "Read-only SigEnergy snapshot",
        "sv": "Läsbaserad SigEnergy-översikt"
      },
      "settings": [],
      "api": {
        "getOverview": {
          "method": "GET",
          "path": "/"
        }
      }
    }
  }
}
